{
  "experiment": {
    "mode": "scalar"
  },
  "training": {
    "seed": {"range": 5},
    "num_train_epochs": 10,
    "logging_steps": 1,
    "save_steps": 1,
    "save_total_limit": 1,
    "lr_scheduler_type": "constant",
    "lora": {
      "r": 16,
      "lora_alpha": 32,
      "lora_dropout": 0.05
    }
  },
  "critic": {
    "model": "gpt-5.5-pro",
    "max_retries": 3
  },
  "artist": {
    "model": "meta-llama/Meta-Llama-3.1-8B-Instruct",
    "generate": {
      "max_new_tokens": 300,
      "temperature": 0.95,
      "top_k": 0,
      "top_p": 1.0,
      "min_p": 0.03
    }
  }
}